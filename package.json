{
  "name": "mcp-marketplace-kr",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "servers/*"
  ],
  "scripts": {
    "dev":         "npm run dev   --workspace=apps/web",
    "build":       "npm run build --workspace=packages/registry && npm run build --workspace=apps/api && npm run build --workspace=apps/web",
    "dev:api":     "npm run dev   --workspace=apps/api",
    "build:all":   "npm run build",
    "lint":        "npm run lint  --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}
